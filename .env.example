# Réglages optionnels. Sur le PC fixe : copier ce fichier en .env (ignoré par git), l'ajuster,
# puis appliquer avec :  bash deploy/compose.sh up -d ollama api worker
# Sans .env, les valeurs par défaut de docker-compose.yml s'appliquent.

# Laptop de dev seulement : utiliser l'Ollama du PC fixe (GPU) par Tailscale. Ne pas mettre
# sur le PC fixe, qui joint son propre Ollama par le réseau Docker.
# LLM_BASE_URL=https://pc-fixe.<tailnet>.ts.net:11434/v1

# Modèle de génération par défaut, et modèles qu'on peut demander via le champ "model"
LLM_MODEL=mistral-small3.2:24b
LLM_ALLOWED_MODELS=mistral-small3.2:24b,gemma4:12b
EMBED_MODEL=bge-m3

# Ollama : requêtes traitées en même temps par modèle, et taille du contexte par requête.
# La mémoire GPU réservée pour le contexte grandit avec OLLAMA_NUM_PARALLEL × OLLAMA_CONTEXT_LENGTH.
# Vérifier après chaque changement : bash deploy/compose.sh exec ollama ollama ps  (« 100% GPU »)
OLLAMA_NUM_PARALLEL=4
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=24h

# Postgres. À fixer AVANT le premier démarrage de la base : le mot de passe est écrit dans le
# volume pgdata à sa création, le changer ensuite ici ne suffit plus. Lettres et chiffres seulement.
POSTGRES_PASSWORD=change-moi

# Mot de passe du rôle Postgres rag_api, avec lequel l'API sert les requêtes (soumis à la
# Row-Level Security). Obligatoire sur le PC fixe. Lettres et chiffres seulement. Le changer
# ici puis redémarrer l'API suffit (il est reposé à chaque démarrage).
API_DB_PASSWORD=changemoiaussi

# Connexion : durée d'un jeton de session (POST /auth/login), en heures
SESSION_TTL_HOURS=168

# Ingestion des PDF
MAX_UPLOAD_MB=100
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
