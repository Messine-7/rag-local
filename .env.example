# Réglages optionnels. Sur le PC fixe : copier ce fichier en .env (ignoré par git), l'ajuster,
# puis appliquer avec :  bash deploy/compose.sh up -d ollama api
# Sans .env, les valeurs par défaut de docker-compose.yml s'appliquent.

# Modèle de génération par défaut, et modèles qu'on peut demander via le champ "model"
LLM_MODEL=mistral-small3.2:24b
LLM_ALLOWED_MODELS=mistral-small3.2:24b,gemma4:12b
EMBED_MODEL=bge-m3

# Ollama : requêtes traitées en même temps par modèle, et taille du contexte par requête.
# La mémoire GPU réservée pour le contexte grandit avec OLLAMA_NUM_PARALLEL × OLLAMA_CONTEXT_LENGTH.
# Vérifier après chaque changement : bash deploy/compose.sh exec ollama ollama ps  (« 100% GPU »)
OLLAMA_NUM_PARALLEL=4
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=24h
